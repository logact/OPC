{
  "name": "@opc/agent-gateway",
  "version": "0.1.0",
  "description": "OPC Agent Gateway: multiplex agents on an edge machine and forward MQTT messages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logact/OPC.git",
    "directory": "packages/agent-gateway"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opc/agent-edge": "workspace:*",
    "@logact-pub/opc-protocol": "workspace:*",
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  }
}

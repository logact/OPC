{
  "name": "@opc/memory",
  "version": "0.1.0",
  "description": "Scoped, durable-memory primitives for OPC agents",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0"
  }
}

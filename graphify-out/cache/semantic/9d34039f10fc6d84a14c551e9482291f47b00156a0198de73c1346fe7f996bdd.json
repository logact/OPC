{"nodes": [{"id": "packages_protocol_changelog_opc_protocol", "label": "@logact-pub/opc-protocol package changelog", "file_type": "document", "source_file": "packages/protocol/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_protocol_changelog_jwt_login", "label": "JWT username/password login (protocol 0.3.0)", "file_type": "rationale", "source_file": "packages/protocol/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds POST /api/v1/auth/login, optional password on registration, LoginRequest/LoginResponse schemas, password_hash decoupled from MQTT token_hash, global Bearer middleware, and required JWT_SECRET. Existing MQTT token connections are unchanged; participants without a password cannot use the new login endpoint."}, {"id": "packages_protocol_changelog_domain_type_ownership", "label": "Domain types owned solely by protocol (opc-core dependency removed)", "file_type": "rationale", "source_file": "packages/protocol/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "protocol source never imported opc-core; the dependency was historical leftover. Removing it means opc-core no longer needs npm publishing. Core domain types (Room/Participant/Message/ServerEvent, plus new ParticipantKind export) continue to be derived from this package's Zod schemas; no breaking change for consumers."}, {"id": "packages_protocol_changelog_mqtt_auth_schema_fix", "label": "mosquitto-go-auth callback schema fix (protocol 0.0.2)", "file_type": "document", "source_file": "packages/protocol/CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "packages_protocol_changelog_domain_type_ownership", "target": "packages_core_changelog_opc_core", "relation": "
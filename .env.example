# 生产环境部署配置示例
#
# 说明：
# - 如果你使用 GitHub Actions 的 Deploy to Production 工作流，此 .env 文件会由 CI
#   自动从 GitHub Secrets/Variables 生成到服务器，无需手动维护。
# - 如果你手动在服务器上启动，可复制此文件为 .env 并修改密码。
# - 真实 .env 包含敏感信息，切勿提交到仓库。

# OPC Server HTTP 端口
PORT=3000

# PostgreSQL 连接串
# 未设置时，docker-compose.prod.yml 会自动根据下方 POSTGRES_* 变量拼接，
# 避免密码不一致导致迁移/服务连接失败。如需使用外部数据库，可显式配置。
# DATABASE_URL=postgres://opc:change-me-to-a-strong-password@postgres:5432/opc

# MQTT broker 地址（生产环境使用 compose 服务名）
MQTT_BROKER_URL=mqtt://mosquitto:1883

# broker superuser 凭据，server 自身连接 broker 时使用
MQTT_SERVER_USERNAME=__server__
MQTT_SERVER_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥，用于签发 HTTP 登录后的 access token（生产环境必须替换为强随机字符串）
JWT_SECRET=change-me-to-a-strong-jwt-secret
# JWT 有效期，可选，默认为 7d
JWT_EXPIRES_IN=7d

# 首个 org owner 的声明式种子（issue #122，推荐的生产 bootstrap 方式）：
# 两个变量必须同时设置；仅在库中尚无 owner 时生效（幂等，owner 存在后会被忽略并打 warning，
# 此时应从部署配置中移除这两个变量）。只设置其中一个会导致 server 启动失败。
OPC_BOOTSTRAP_OWNER_ID=owner
OPC_BOOTSTRAP_OWNER_PASSWORD=change-me-to-a-strong-password

# 未鉴权的首个人类注册（open door bootstrap）默认关闭。
# 仅本地 dev 场景可显式打开，生产环境切勿开启：
# OPC_ALLOW_OPEN_BOOTSTRAP=true

# PostgreSQL 初始化凭据
POSTGRES_USER=opc
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=opc

# MQTT broker 宿主机映射端口
MQTT_PORT=1883

# Agent Gateway 配置（仅边缘 gateway 模式需要）
# EDGE_GATEWAY_ID=gw-myhost-123
# EDGE_GATEWAY_TOKEN=                    # 需先用 owner 凭据预注册 gateway 后填入（自 issue #122 起未鉴权注册已关闭）
# OPC_SERVER_URL=http://localhost:3000
# OPC_BROKER_URL=mqtt://localhost:1883
# EDGE_MODEL_PROVIDER=anthropic
# EDGE_MODEL_ID=claude-3-5-sonnet-20241022
# EDGE_MODEL_API_KEY=sk-...

# CLI 委托工具（issue #144）：goal/task 模式 agent 可把任务委派给本机
# codex / kimi / claude CLI（默认启用，spawn 时探测，未安装自动跳过；
# 可用 EDGE_AGENT_TOOLS 裁剪）。子进程继承 gateway 环境，按需填入对应 key
# （或使用各 CLI 自身的登录态）。注意：CLI 以 full-access 运行，workspace 仅
# 锚定 cwd 而非沙箱。
# OPENAI_API_KEY=sk-...          # codex
# MOONSHOT_API_KEY=sk-...        # kimi
# ANTHROPIC_API_KEY=sk-ant-...   # claude

# 生产部署时由 CI 注入，指向刚构建的 server 镜像
SERVER_IMAGE=ghcr.io/logact/opc-server:master

# MQTT broker 镜像（预构建，含 go-auth HTTP 认证插件）
MOSQUITTO_IMAGE=ghcr.io/logact/opc-mosquitto:latest
